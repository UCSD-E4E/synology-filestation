{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "381d1b8eaa5a87f621350a19b1ecda07b5db5320",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "synology-filestation-fuse",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "exclude-paths": [
        ".github",
        "nix"
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "SynologyFuse.Gui/SynologyFuse.Gui.csproj"
        },
        {
          "type": "toml",
          "path": "rust/synology-filestation-core/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "rust/synology-filestation-fuse/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "python/synology_filestation/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'synology-filestation-core' || @.name.value == 'synology-filestation-fuse' || @.name.value == 'synology_filestation')].version"
        }
      ]
    }
  }
}
